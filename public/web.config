<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- 1. Cấu hình tài liệu mặc định: ưu tiên index.php -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <!-- 2. Tắt tính năng liệt kê thư mục để bảo mật -->
        <directoryBrowse enabled="false" />

        <!-- 3. Không ghi đè error handling của Laravel và ứng dụng -->
        <httpErrors existingResponse="PassThrough" />

        <!-- 4. Quy tắc URL Rewrite cho Laravel -->
        <rewrite>
            <rules>
                <!-- Rule 1: Bỏ dấu gạch chéo cuối URL nếu không phải thư mục vật lý -->
                <rule name="Redirect Trailing Slashes If Not A Directory" stopProcessing="true">
                    <match url="^(.+)/$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Rule 2: Chuyển toàn bộ request không phải file/thư mục vật lý đến index.php -->
                <rule name="Laravel Front Controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <!-- 5. Chặn truy cập trực tiếp các file cấu hình và nhạy cảm -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment=".git" />
                    <add segment="composer.json" />
                    <add segment="composer.lock" />
                    <add segment="package.json" />
                    <add segment="package-lock.json" />
                    <add segment="vite.config.js" />
                    <add segment="web.config" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <!-- 6. Khai báo MIME types cho static assets (Vite / Web fonts / SVG) -->
        <staticContent>
            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            <remove fileExtension=".woff" />
            <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
        </staticContent>
    </system.webServer>
</configuration>
